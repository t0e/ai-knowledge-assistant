# ==============================================================================
# AI Knowledge Assistant - Environment Configuration
# ==============================================================================

# Application
PROJECT_NAME="AI Knowledge Assistant"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars_long

# Authentication & Security
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME=access_token
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# CORS (JSON Array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL with pgvector)
# For Docker network:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/knowledge_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/knowledge_db

# For Local Host development outside Docker (optional override):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_db
# SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/knowledge_db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_db
POSTGRES_PORT=5432

# Redis Cache & Background Tasks
# For Docker network:
REDIS_URL=redis://redis:6379/0
# For Local Host development:
# REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
PORT=3000

# AI Provider (Phase 3 placeholder)
OPENAI_API_KEY=your_openai_api_key_here
