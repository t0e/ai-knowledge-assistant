# ==============================================================================
# AI Knowledge Assistant - Environment Configuration
# ==============================================================================

# Application
PROJECT_NAME="AI Knowledge Assistant"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars_long

# Authentication & Security
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME=access_token
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# CORS (JSON Array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/knowledge_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/knowledge_db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_db
POSTGRES_PORT=5432

# Redis Cache & Background Tasks (Phase 7)
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
PROCESSING_QUEUE=ai_knowledge_document_processing
JOB_TIMEOUT=300
JOB_MAX_RETRIES=3
JOB_RETRY_DELAY=5

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
PORT=3000

# Embeddings & Vector Search (Phase 5)
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DEFAULT_TOP_K=5
MAX_TOP_K=20

# LLM & RAG Orchestration (Phase 6)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500
RAG_SIMILARITY_THRESHOLD=0.20
RAG_MAX_CONTEXT_CHUNKS=5
RAG_MAX_HISTORY_MESSAGES=6

# Website Ingestion & SSRF Protection (Phase 8)
MAX_WEB_CONTENT_SIZE_MB=10
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_FETCH_MAX_REDIRECTS=5
WEB_FETCH_USER_AGENT="Mozilla/5.0 (compatible; AIKnowledgeAssistantBot/1.0; +https://github.com)"
